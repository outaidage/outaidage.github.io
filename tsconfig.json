}
"compilerOptions": {
  "types": ["vitepress/client"],
  "jsx": "preserve",
  "strict": true,
  "moduleResolution": "bundler",
  "resolveJsonModule": true
},
"include": ["docs/.vitepress/**/*.ts", "scripts/**/*.ts"]