---
import "../styles/global.css";
import "../styles/video-background.css";
import { ClientRouter } from "astro:transitions";
import DigitalUniverse from "@/components/DigitalUniverse.astro";
import OutaiLogo from "@/components/OutaiLogo.astro";
import CommandTerminal from "@/components/CommandTerminal";
import VideoSceneManager from "@/components/background/VideoSceneManager";
import { SITE } from "@/lib/site";
import { getNavModules } from "@/lib/home-modules";
import BootIntro from "@/components/BootIntro.astro";
// 导航由首页模块驱动（show_in_nav=true 的已发布模块）；失败时回退到 SITE.nav。
const navItems = (await getNavModules()).map((m) => ({ label: m.name, href: m.path }));
const { title = SITE.title, description = SITE.description, type = "website", image, noindex = false } = Astro.props as {
  title?: string; description?: string; type?: "website" | "article"; image?: string; noindex?: boolean;
};
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).toString();
const ogImage = image ? new URL(image, SITE.url).toString() : new URL("og.png", SITE.url).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03040B" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      try {
        var saved = localStorage.getItem("outai-motion");
        if (saved === "reduced" || saved === "full") {
          document.documentElement.dataset.motion = saved;
        }
      } catch (e) {}
      // 滚动渐现的开关：JS 可用时才隐藏 [data-reveal]（无 JS 时内容直接可见）。
      document.documentElement.classList.add("js-reveal");
    </script>
  </head>
  <body>
    {path === "/" && <BootIntro />}
    <VideoSceneManager client:load />
    <DigitalUniverse />
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={import.meta.env.BASE_URL} transition:name="outai-logo">
          <OutaiLogo size={32} withWordmark />
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {navItems.map((item) => <a class:list={{ active: path.startsWith(item.href) }} href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${item.href}`}>{item.label}</a>)}
        </nav>
        <div class="top-actions">
          <span class="hud-label dim" aria-hidden="true">SYSTEM ONLINE</span>
          <a class="universe-link" href={`${import.meta.env.BASE_URL}#universe`}>☉ 进入宇宙</a>
          <button class="terminal-btn" id="terminal-btn" type="button" aria-label="打开终端">⌘ TERMINAL</button>
          <a class="icon-link" href={`${import.meta.env.BASE_URL}search/`} aria-label="搜索">⌕</a>
          <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="打开菜单">
            <span></span><span></span><span></span>
          </button>
        </div>
      </header>
      <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
        <a href={`${import.meta.env.BASE_URL}#universe`}>☉ 进入宇宙</a>
        {navItems.map((item) => <a class:list={{ active: path.startsWith(item.href) }} href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${item.href}`}>{item.label}</a>)}
        <a href={`${import.meta.env.BASE_URL}search/`}>搜索 ⌕</a>
        <a id="admin-link-mobile" href={`${import.meta.env.BASE_URL}admin/`} hidden>管理后台 ↗</a>
      </nav>
      <main data-pagefind-ignore={noindex || undefined}><slot /></main>
      <footer class="footer">
        <span>© {new Date().getFullYear()} OUTAI</span>
        <span><a href={`${import.meta.env.BASE_URL}colophon/`}>Colophon</a> <i>·</i> <a href={`${import.meta.env.BASE_URL}bookmarklet/`}>Bookmarklet</a></span>
        <span>BUILT WITH ASTRO <i>·</i> EXPLORE / COLLECT / BUILD</span>
      </footer>
    </div>
    <CommandTerminal client:load />
    <script is:inline>
      // Menu + motion toggle, via event delegation so the handlers survive
      // Astro view-transition navigation (the footer/header DOM is replaced
      // on each client-side navigation, but this document-level listener
      // persists). The toggle label is re-synced on every astro:page-load.
      (function () {
        var root = document.documentElement;
        function menuBtn() { return document.querySelector(".menu-button"); }
        function mobileNav() { return document.getElementById("mobile-nav"); }
        function motionBtn() { return document.getElementById("motion-toggle"); }
        function setOpen(open) {
          var btn = menuBtn();
          var nav = mobileNav();
          if (!btn || !nav) return;
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          btn.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
          btn.classList.toggle("open", open);
          nav.hidden = !open;
        }
        function isReduced() {
          // No stored preference means motion is ON. The OS
          // reduced-motion setting alone must not silently disable the
          // site: it differs between normal and incognito profiles on
          // the same machine (incognito has no stored preference), so
          // the same browser would show 3D in one window and hide it
          // in the other. Only an explicit stored "reduced" (footer
          // toggle) turns motion off.
          return root.dataset.motion === "reduced";
        }
        function syncMotionLabel() {
          var btn = motionBtn();
          if (!btn) return;
          var reduced = isReduced();
          btn.textContent = reduced ? "动效：关" : "动效：开";
          btn.setAttribute("aria-pressed", reduced ? "true" : "false");
        }
        function syncMotionFromStorage() {
          // Re-read the stored preference. View-transition back/forward
          // restores a cached page snapshot whose dataset.motion may be
          // stale (the head script that reads localStorage only runs on a
          // full load), so re-apply it here on every navigation.
          try {
            var saved = localStorage.getItem("outai-motion");
            if (saved === "reduced" || saved === "full") {
              root.dataset.motion = saved;
            }
          } catch (err) {}
          syncMotionLabel();
        }
        document.addEventListener("click", function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          if (t.closest("#terminal-btn")) {
            window.dispatchEvent(new CustomEvent("outai:toggle-terminal"));
            return;
          }
          if (t.closest(".menu-button")) {
            var nav = mobileNav();
            setOpen(nav ? nav.hidden : false);
            return;
          }
          if (t.closest("#mobile-nav a")) { setOpen(false); return; }
          if (t.closest("#motion-toggle")) {
            var next = isReduced() ? "full" : "reduced";
            root.dataset.motion = next;
            try { localStorage.setItem("outai-motion", next); } catch (err) {}
            syncMotionLabel();
            return;
          }
          if (t.closest("#replay-boot")) {
            // 重播开场动画：回首页并一次性播放（覆盖"不再显示"，不覆盖减弱动效）。
            try { sessionStorage.setItem("outai-boot-replay", "1"); } catch (err) {}
            window.location.href = "/";
            return;
          }
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") setOpen(false);
        });
        document.addEventListener("astro:page-load", function () {
          setOpen(false);
          syncMotionFromStorage();
          syncAdminLinks();
        });
        window.addEventListener("pageshow", function () {
          syncMotionFromStorage();
          syncAdminLinks();
        });
        // 仅登录的管理员可见"管理后台"入口：检查 Supabase 会话。
        // 未登录时链接保持 hidden；登录后显示。后台页面本身仍要求登录。
        function syncAdminLinks() {
          try {
            var show = false;
            for (var i = 0; i < localStorage.length; i++) {
              var k = localStorage.key(i);
              if (k && k.indexOf("sb-") === 0 && k.indexOf("-auth-token") > 0) {
                var raw = localStorage.getItem(k);
                if (raw) {
                  var sess = JSON.parse(raw);
                  if (sess && sess.access_token) { show = true; break; }
                }
              }
            }
            var m = document.getElementById("admin-link-mobile");
            if (m) m.hidden = !show;
          } catch (err) {}
        }
        syncAdminLinks();
        syncMotionLabel();
      })();
    </script>
    <script>
      // Digital universe background. Bundled by Astro (module script in the
      // layout, so it is reliably included). Re-initialises on every
      // astro:page-load because view-transition navigation replaces the
      // canvas element; the previous instance is cleaned up first.
      import { initUniverse } from "@/lib/universe-canvas";
      let cleanup: (() => void) | null = null;
      function startUniverse() {
        if (cleanup) { cleanup(); cleanup = null; }
        const canvas = document.getElementById("universe-canvas");
        if (canvas instanceof HTMLCanvasElement) {
          cleanup = initUniverse(canvas);
        }
      }
      document.addEventListener("astro:page-load", startUniverse);
      startUniverse();
    </script>
    <script>
      // 3D tilt for [data-tilt] cards (DIGITAL UNIVERSE 2.0). Lightweight
      // pointer-driven rotateX/rotateY with a glow shift; disabled when
      // motion is reduced or on coarse pointers. Re-attaches on every
      // astro:page-load because view transitions replace the card DOM.
      import { initTilt } from "@/lib/tilt";
      let tiltCleanup: (() => void) | null = null;
      function startTilt() {
        if (tiltCleanup) { tiltCleanup(); tiltCleanup = null; }
        tiltCleanup = initTilt();
      }
      document.addEventListener("astro:page-load", startTilt);
      startTilt();
    </script>
    <script>
      // Wormhole page transition (DIGITAL UNIVERSE 2.0). GSAP energy burst
      // on internal nav clicks, then Astro client-side navigation. Never
      // blocks routing: reduced motion or a GSAP failure navigates at once.
      import { initWormhole } from "@/lib/wormhole";
      let wormholeCleanup: (() => void) | null = null;
      function startWormhole() {
        if (wormholeCleanup) { wormholeCleanup(); wormholeCleanup = null; }
        wormholeCleanup = initWormhole();
      }
      document.addEventListener("astro:page-load", startWormhole);
      startWormhole();
    </script>
    <script>
      // 双形态切换（普通模式 ⇄ 沉浸式宇宙模式）。放在 MainLayout 的模块
      // 脚本里（而非首页 </MainLayout> 之后）：后者会被 Astro 输出到
      // </html> 之外，视图切换时不再执行，导致“进入宇宙”只滚动不全屏。
      // 同一个 Canvas、同一个场景实例：全屏只是把首页的 .core-stage 固定
      // 到视口并让相机拉远到太阳系视角；退出时原样收回，不重建场景。
      // 状态用 #universe hash 表达：打开时 pushState，返回键可退出。
      // 本脚本在每个页面都执行一次，但 stage 只在首页存在：所有操作都
      // 在调用时才查找 stage，不在首页时点击“进入宇宙”走默认导航到
      // /#universe，首页加载后 astro:page-load 再自动打开。
      (function () {
        let pushed = false;
        const getStage = () => document.getElementById("core-stage");
        const isOpen = () => document.body.classList.contains("universe-open");
        function open() {
          const stage = getStage();
          if (!stage) return;
          if (!isOpen()) {
            stage.classList.add("universe-full");
            document.body.classList.add("universe-open");
            if (window.location.hash !== "#universe") {
              history.pushState({}, "", "#universe");
              pushed = true;
            }
          }
          // 每次都派发：视图切换会重建 SpaceCore，若只在首次派发，重建后
          // 的 SpaceCore 收不到事件（无退出按钮、模式仍是 UNIVERSE），而
          // CSS 类已在 body/stage 上（全屏已展开）——这正是导航栏入口的 bug。
          window.dispatchEvent(new CustomEvent("outai:universe", { detail: { open: true } }));
        }
        function close() {
          const stage = getStage();
          if (!isOpen()) return;
          if (stage) stage.classList.remove("universe-full");
          document.body.classList.remove("universe-open");
          window.dispatchEvent(new CustomEvent("outai:universe", { detail: { open: false } }));
          if (pushed && window.location.hash === "#universe") {
            pushed = false;
            history.back();
          } else {
            pushed = false;
          }
        }
        // 捕获阶段监听：Astro 路由也在 document 上监听点击（冒泡阶段）。
        // 导航栏链接是 "/#universe"（绝对路径），路由会把它当成一次到首页
        // 的导航并重建页面，导致 SpaceCore 状态丢失；捕获阶段先拦截并
        // stopImmediatePropagation，路由就收不到这次点击，不再导航。
        document.addEventListener("click", (e) => {
          const t = e.target as Element | null;
          const a = t?.closest?.('a[href="#universe"], a[href="/#universe"]') as HTMLAnchorElement | null;
          if (!a) return;
          // 不在首页时没有 stage：不拦截，走默认导航到 /#universe。
          if (!getStage()) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          open();
        }, true);
        window.addEventListener("outai:universe-close", () => close());
        window.addEventListener("popstate", () => {
          if (window.location.hash !== "#universe") close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) close();
        });
        // 开场动画播完后再打开（无开场时立即打开）。
        const maybeOpenFromHash = () => { if (window.location.hash === "#universe") open(); };
        const boot = (window as unknown as { __outaiBoot?: { play?: boolean } }).__outaiBoot;
        if (boot && boot.play) {
          window.addEventListener("outai:boot-done", maybeOpenFromHash, { once: true });
        } else {
          maybeOpenFromHash();
        }
        // 视图切换后（Astro view transitions）若 hash 仍在，重新打开。
        document.addEventListener("astro:page-load", maybeOpenFromHash);
      })();
    </script>
    <script is:inline>
      // 滚动渐现：带 .reveal-group 的区块进入视口时加 .in-view，子元素按 --i 依次蹦出。
      // 减弱动效（只认站内开关 dataset.motion === "reduced"）时直接全部显示，不等滚动。
      // 视图切换（astro:page-load）与 bfcache 返回（pageshow）后重新接管新页面的区块。
      (function () {
        function setupReveals() {
          var groups = document.querySelectorAll(".reveal-group");
          if (!groups.length) return;
          if (document.documentElement.dataset.motion === "reduced") {
            groups.forEach(function (g) { g.classList.add("in-view"); });
            return;
          }
          if (!("IntersectionObserver" in window)) {
            groups.forEach(function (g) { g.classList.add("in-view"); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add("in-view");
                io.unobserve(en.target);
              }
            });
          }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
          groups.forEach(function (g) {
            if (g.classList.contains("in-view") || g.getAttribute("data-reveal-observed")) return;
            g.setAttribute("data-reveal-observed", "1");
            io.observe(g);
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupReveals);
        } else {
          setupReveals();
        }
        document.addEventListener("astro:page-load", setupReveals);
        window.addEventListener("pageshow", setupReveals);
      })();
    </script>
  </body>
</html>
