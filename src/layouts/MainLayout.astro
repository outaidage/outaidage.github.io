---
import "../styles/global.css";
import "../styles/video-background.css";
import { ClientRouter } from "astro:transitions";
import DigitalUniverse from "@/components/DigitalUniverse.astro";
import OutaiLogo from "@/components/OutaiLogo.astro";
import CommandTerminal from "@/components/CommandTerminal";
import VideoSceneManager from "@/components/background/VideoSceneManager";
import VideoControls from "@/components/background/VideoControls";
import { SITE } from "@/lib/site";
const { title = SITE.title, description = SITE.description, type = "website", image, noindex = false } = Astro.props as {
  title?: string; description?: string; type?: "website" | "article"; image?: string; noindex?: boolean;
};
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).toString();
const ogImage = image ? new URL(image, SITE.url).toString() : new URL("og.png", SITE.url).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03040B" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      try {
        var saved = localStorage.getItem("outai-motion");
        if (saved === "reduced" || saved === "full") {
          document.documentElement.dataset.motion = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <VideoSceneManager client:load />
    <DigitalUniverse />
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={import.meta.env.BASE_URL} transition:name="outai-logo">
          <OutaiLogo size={32} withWordmark />
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {SITE.nav.map((item) => <a class:list={{ active: path.startsWith(item.href) }} href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${item.href}`}>{item.label}</a>)}
        </nav>
        <div class="top-actions">
          <span class="hud-label dim" aria-hidden="true">SYSTEM ONLINE</span>
          <button class="terminal-btn" id="terminal-btn" type="button" aria-label="打开终端">⌘ TERMINAL</button>
          <a class="icon-link" href={`${import.meta.env.BASE_URL}search/`} aria-label="搜索">⌕</a>
          <a class="admin-link" href={`${import.meta.env.BASE_URL}admin/`}>管理后台 <span>↗</span></a>
          <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="打开菜单">
            <span></span><span></span><span></span>
          </button>
        </div>
      </header>
      <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
        {SITE.nav.map((item) => <a class:list={{ active: path.startsWith(item.href) }} href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${item.href}`}>{item.label}</a>)}
        <a href={`${import.meta.env.BASE_URL}search/`}>搜索 ⌕</a>
        <a href={`${import.meta.env.BASE_URL}admin/`}>管理后台 ↗</a>
      </nav>
      <main data-pagefind-ignore={noindex || undefined}><slot /></main>
      <footer class="footer">
        <span>© {new Date().getFullYear()} OUTAI</span>
        <span><a href={`${import.meta.env.BASE_URL}colophon/`}>Colophon</a> <i>·</i> <a href={`${import.meta.env.BASE_URL}bookmarklet/`}>Bookmarklet</a></span>
        <span>BUILT WITH ASTRO <i>·</i> EXPLORE / COLLECT / BUILD</span>
        <VideoControls client:load />
        <button class="motion-toggle" id="motion-toggle" type="button" aria-pressed="false">动效：开</button>
      </footer>
    </div>
    <CommandTerminal client:load />
    <script is:inline>
      // Menu + motion toggle, via event delegation so the handlers survive
      // Astro view-transition navigation (the footer/header DOM is replaced
      // on each client-side navigation, but this document-level listener
      // persists). The toggle label is re-synced on every astro:page-load.
      (function () {
        var root = document.documentElement;
        function menuBtn() { return document.querySelector(".menu-button"); }
        function mobileNav() { return document.getElementById("mobile-nav"); }
        function motionBtn() { return document.getElementById("motion-toggle"); }
        function setOpen(open) {
          var btn = menuBtn();
          var nav = mobileNav();
          if (!btn || !nav) return;
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          btn.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
          btn.classList.toggle("open", open);
          nav.hidden = !open;
        }
        function isReduced() {
          if (root.dataset.motion === "reduced") return true;
          if (root.dataset.motion === "full") return false;
          return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        }
        function syncMotionLabel() {
          var btn = motionBtn();
          if (!btn) return;
          var reduced = isReduced();
          btn.textContent = reduced ? "动效：关" : "动效：开";
          btn.setAttribute("aria-pressed", reduced ? "true" : "false");
        }
        function syncMotionFromStorage() {
          // Re-read the stored preference. View-transition back/forward
          // restores a cached page snapshot whose dataset.motion may be
          // stale (the head script that reads localStorage only runs on a
          // full load), so re-apply it here on every navigation.
          try {
            var saved = localStorage.getItem("outai-motion");
            if (saved === "reduced" || saved === "full") {
              root.dataset.motion = saved;
            }
          } catch (err) {}
          syncMotionLabel();
        }
        document.addEventListener("click", function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          if (t.closest("#terminal-btn")) {
            window.dispatchEvent(new CustomEvent("outai:toggle-terminal"));
            return;
          }
          if (t.closest(".menu-button")) {
            var nav = mobileNav();
            setOpen(nav ? nav.hidden : false);
            return;
          }
          if (t.closest("#mobile-nav a")) { setOpen(false); return; }
          if (t.closest("#motion-toggle")) {
            var next = isReduced() ? "full" : "reduced";
            root.dataset.motion = next;
            try { localStorage.setItem("outai-motion", next); } catch (err) {}
            syncMotionLabel();
          }
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") setOpen(false);
        });
        document.addEventListener("astro:page-load", function () {
          setOpen(false);
          syncMotionFromStorage();
        });
        window.addEventListener("pageshow", function () {
          syncMotionFromStorage();
        });
        syncMotionLabel();
      })();
    </script>
    <script>
      // Digital universe background. Bundled by Astro (module script in the
      // layout, so it is reliably included). Re-initialises on every
      // astro:page-load because view-transition navigation replaces the
      // canvas element; the previous instance is cleaned up first.
      import { initUniverse } from "@/lib/universe-canvas";
      let cleanup: (() => void) | null = null;
      function startUniverse() {
        if (cleanup) { cleanup(); cleanup = null; }
        const canvas = document.getElementById("universe-canvas");
        if (canvas instanceof HTMLCanvasElement) {
          cleanup = initUniverse(canvas);
        }
      }
      document.addEventListener("astro:page-load", startUniverse);
      startUniverse();
    </script>
    <script>
      // 3D tilt for [data-tilt] cards (DIGITAL UNIVERSE 2.0). Lightweight
      // pointer-driven rotateX/rotateY with a glow shift; disabled when
      // motion is reduced or on coarse pointers. Re-attaches on every
      // astro:page-load because view transitions replace the card DOM.
      import { initTilt } from "@/lib/tilt";
      let tiltCleanup: (() => void) | null = null;
      function startTilt() {
        if (tiltCleanup) { tiltCleanup(); tiltCleanup = null; }
        tiltCleanup = initTilt();
      }
      document.addEventListener("astro:page-load", startTilt);
      startTilt();
    </script>
    <script>
      // Wormhole page transition (DIGITAL UNIVERSE 2.0). GSAP energy burst
      // on internal nav clicks, then Astro client-side navigation. Never
      // blocks routing: reduced motion or a GSAP failure navigates at once.
      import { initWormhole } from "@/lib/wormhole";
      let wormholeCleanup: (() => void) | null = null;
      function startWormhole() {
        if (wormholeCleanup) { wormholeCleanup(); wormholeCleanup = null; }
        wormholeCleanup = initWormhole();
      }
      document.addEventListener("astro:page-load", startWormhole);
      startWormhole();
    </script>
  </body>
</html>
