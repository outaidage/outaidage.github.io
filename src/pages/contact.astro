---
import MainLayout from "@/layouts/MainLayout.astro";
import { getPageContent } from "@/lib/page-content";

// 联系页内容由后台「页面内容」管理（page_content 表 id='contact'），
// 失败或缺失时回落内置默认值。
const page = await getPageContent("contact");

// 备注里若含链接（如“本站源代码：https://…”），把链接部分渲染成可点击文字。
function noteParts(note: string): { before: string; url: string } {
  const idx = note.indexOf("http");
  if (idx === -1) return { before: note, url: "" };
  return { before: note.slice(0, idx), url: note.slice(idx).trim() };
}
---
<MainLayout title="联系 — OUTAI">
  <header class="page-head" data-ghost="CONTACT"><div class="eyebrow"><span class="pulse"></span> CONTACT</div><h1>{page.title.replace(/\.$/, "")}</h1><p>{page.subtitle}</p></header>
  <div class="article-body">
    {page.items.map((it) => {
      const note = noteParts(it.note ?? "");
      return (
        <>
          <h2>{it.heading ?? ""}</h2>
          <p><a href={it.href ?? "#"}>{it.label ?? ""}</a></p>
          {it.note ? (
            <p style="color:#929dab;font-size:12px">
              {note.before}
              {note.url ? <a href={note.url}>{note.url}</a> : null}
            </p>
          ) : null}
        </>
      );
    })}
  </div>
</MainLayout>
