---
import MainLayout from "@/layouts/MainLayout.astro";
import { getPageContent } from "@/lib/page-content";

// 关于页内容由后台「页面内容」管理（page_content 表 id='about'），
// 失败或缺失时回落内置默认值。
const page = await getPageContent("about");
const base = import.meta.env.BASE_URL;
---
<MainLayout title="关于 — OUTAI">
  <header class="page-head" data-ghost="ABOUT"><div class="eyebrow"><span class="pulse"></span> ABOUT THIS SPACE</div><h1>{page.title.replace(/\.$/, "")}</h1><p>{page.subtitle}</p></header>
  <div class="article-body">
    {page.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        <p>{s.text}</p>
      </>
    ))}
    <p>联系：<a href="mailto:outaidage@gmail.com">outaidage@gmail.com</a>，也可以去<a href={`${base}contact/`}>联系页面</a>。</p>
  </div>
</MainLayout>
