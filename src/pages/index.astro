---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { isVisiblePost } from "@/lib/blog";
import Subscribe from "@/components/Subscribe";
import Terminal from "@/components/Terminal";
import SpaceCore from "@/components/SpaceCore";
import HomeModules from "@/components/HomeModules";
import LatestBookmarks from "@/components/LatestBookmarks";
import { supabase } from "@/lib/supabase";
import { getHomeModules } from "@/lib/home-modules";
import { getHeroContent } from "@/lib/hero-content";
import HeroText from "@/components/HeroText.astro";

// 首页 Hero（Supabase hero_content 驱动，失败时回退内置默认文案）。
const hero = await getHeroContent();
// 文字样式（migration 020）：只输出非默认的值，默认走 CSS 本身的样式。
const heroStyle = [
  hero.title_color ? `--hero-title-color:${hero.title_color}` : "",
  hero.subtitle_color ? `--hero-subtitle-color:${hero.subtitle_color}` : "",
  hero.title_scale !== 1 ? `--hero-title-scale:${hero.title_scale}` : "",
  hero.text_opacity !== 1 ? `--hero-text-opacity:${hero.text_opacity}` : "",
].filter(Boolean).join(";");
// 逐字动画时序（毫秒）：眉题先蹦，标题跟上，副标题随后，按钮/标签淡入。
const eyebrowStart = 0;
const titleStart = 150;
const titleStep = 55;
const subStart = titleStart + (hero.title_plain.length + hero.title_grad.length) * titleStep + 100;
const subStep = 28;
const actionsDelay = subStart + hero.subtitle.length * subStep + 150;
const tickerDelay = actionsDelay + 150;

// 最新文章（真实数据；isVisiblePost 排除草稿与未来日期的文章）。
const posts = (await getCollection("blog", ({data}) => isVisiblePost(data))).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const allPosts = (await getCollection("blog", ({data}) => isVisiblePost(data))).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
// 首页模块（Supabase 驱动，失败时回退内置默认模块）。
const modules = await getHomeModules();
// 真实书签数（公开 + active）。
let bookmarkCount: number | null = null;
let latestBookmarks: { id: string; title: string; url: string; category: string }[] = [];
try {
  if (supabase) {
    const { count, error } = await supabase.from("public_bookmarks").select("id", { count: "exact", head: true });
    if (!error && typeof count === "number") bookmarkCount = count;
    const { data } = await supabase.from("public_bookmarks").select("id,title,url,category").order("created_at", { ascending: false }).limit(3);
    if (data) latestBookmarks = data as typeof latestBookmarks;
  }
} catch { bookmarkCount = null; }
// 最近更新的项目（真实数据）。
let recentProjects: { id: string; name: string; description: string; status: string }[] = [];
try {
  if (supabase) {
    const { data } = await supabase.from("projects").select("id,name,description,status").order("sort_order", { ascending: true }).limit(3);
    if (data) recentProjects = data as typeof recentProjects;
  }
} catch { recentProjects = []; }
// 网站更新动态（真实数据）。
let changelog: { id: string; version: string; title: string; published_at: string }[] = [];
try {
  if (supabase) {
    const { data } = await supabase.from("changelog_entries").select("id,version,title,published_at").order("published_at", { ascending: false }).limit(3);
    if (data) changelog = data as typeof changelog;
  }
} catch { changelog = []; }
// 3D 星球节点的内容数量（真实数据；没有对应计数的模块不显示数量）。
// 文章数 = 可见文章；书签数 = 公开书签；项目数 = projects 表行数；资源数 = recommended_links 行数。
let nodeCounts: Record<string, number> = { articles: allPosts.length };
if (bookmarkCount !== null) nodeCounts.bookmarks = bookmarkCount;
let categoryCount: number | null = null;
try {
  if (supabase) {
    const { count: pc } = await supabase.from("projects").select("id", { count: "exact", head: true });
    if (typeof pc === "number") nodeCounts.projects = pc;
    const { count: rc } = await supabase.from("recommended_links").select("id", { count: "exact", head: true });
    if (typeof rc === "number") nodeCounts.resources = rc;
    const { count: cc } = await supabase.from("categories").select("id", { count: "exact", head: true });
    if (typeof cc === "number") categoryCount = cc;
  }
} catch { /* 数量缺失时节点不显示计数，不伪造 */ }
// 行星卫星子功能（真实数据、真实页面；没有子功能的行星不建卫星，不伪造）。
// 水星 = 最新 3 篇文章 + 全部文章；火星 = 最近项目 + 全部项目；
// 土星 = 最近收藏（外链）+ 收藏分类；地球 = 关于/联系/更新日志/资源；
// 天王星 = 全部工具；海王星 = 留言板/联系方式。金星、木星、太阳暂无子功能。
const base = import.meta.env.BASE_URL;
const planetSatellites: Record<string, { id: string; name: string; description: string; path: string; count?: number }[]> = {
  mercury: [
    ...posts.map(p => ({ id: `mercury-${p.slug}`, name: p.data.title, description: p.data.description || "最新文章", path: `${base}blog/${p.slug}/` })),
    { id: "mercury-all", name: "全部文章", description: "文章中心，全部文章列表", path: `${base}blog/`, count: allPosts.length },
  ],
  earth: [
    { id: "earth-about", name: "个人介绍", description: "关于我与 OUTAI", path: `${base}about/` },
    { id: "earth-contact", name: "联系方式", description: "联系 outaidage", path: `${base}contact/` },
    { id: "earth-changelog", name: "更新日志", description: "网站更新记录", path: `${base}changelog/` },
    { id: "earth-links", name: "资源中心", description: "推荐链接", path: `${base}links/`, count: nodeCounts.resources },
  ],
  mars: [
    ...recentProjects.map(p => ({ id: `mars-${p.id}`, name: p.name, description: p.description || "项目", path: `${base}projects/` })),
    { id: "mars-all", name: "全部项目", description: "项目空间", path: `${base}projects/`, count: nodeCounts.projects },
  ],
  saturn: [
    ...latestBookmarks.map(b => ({ id: `saturn-${b.id}`, name: b.title, description: b.category || "最近收藏", path: b.url })),
    { id: "saturn-cats", name: "收藏分类", description: "书签分类", path: `${base}collection/`, count: categoryCount ?? undefined },
  ],
  uranus: [
    { id: "uranus-all", name: "全部工具", description: "JSON、Base64、字符统计", path: `${base}toolbox/`, count: 3 },
  ],
  neptune: [
    { id: "neptune-guestbook", name: "留言板", description: "留下你的话", path: `${base}guestbook/` },
    { id: "neptune-contact", name: "联系方式", description: "联系 outaidage", path: `${base}contact/` },
  ],
};
const lastUpdate = allPosts[0]?.data.pubDate;
---
<MainLayout>
  <section class="hero-du" style={heroStyle || undefined}>
    <div class="hero-ghost" aria-hidden="true">Explore</div>
    <div class="eyebrow"><span class="pulse"></span> <HeroText text={hero.eyebrow} start={eyebrowStart} step={25} /></div>
    <h1 class={hero.title_color ? "hero-solid" : undefined}><HeroText text={hero.title_plain} start={titleStart} step={titleStep} /><HeroText text={hero.title_grad} start={titleStart + hero.title_plain.length * titleStep} step={titleStep} cls="grad" /></h1>
    <p><HeroText text={hero.subtitle} start={subStart} step={subStep} /></p>
    <div class="hero-actions hero-fade" style={`--d:${actionsDelay}ms`}>
      {hero.buttons.map((b) => {
        const href = b.href.startsWith("#") || b.href.startsWith("http") ? b.href : `${base}${b.href.replace(/^\//, "")}`;
        return <a class={`button ${b.style}`} href={href}>{b.label}</a>;
      })}
    </div>
    <div class="ticker hero-fade" style={`--d:${tickerDelay}ms`} aria-hidden="true">{hero.tags.map((t) => <span><b>⌁</b> {t}</span>)}</div>
    <Terminal client:load command={hero.terminal_command} output={hero.terminal_output} />
  </section>

  <section class="core-stage glass-panel" id="core-stage" aria-label="数字宇宙核心">
    <SpaceCore client:load planetSatellites={planetSatellites} />
    <div class="core-fallback" id="core-fallback" hidden>3D 核心已关闭 · 使用轻量模式</div>
  </section>

  <section class="core-status glass-panel" aria-label="核心状态">
    <div class="cs-item"><span class="cs-key">CORE STATUS</span><span class="cs-val"><span class="pulse" style="display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px"></span><span class="on">● ACTIVE</span></span></div>
    <div class="cs-item"><span class="cs-key">ORBITAL NODE</span><span class="cs-val">OUTAI / 001</span></div>
    <div class="cs-item"><span class="cs-key">SYSTEM</span><span class="cs-val">ONLINE</span></div>
    <div class="cs-item"><span class="cs-key">RENDER</span><span class="cs-val">WEBGL · ON DEMAND</span></div>
  </section>

  <section class="section reveal-group">
    <div class="section-head" data-ghost="NAVIGATION"><h2>NAVIGATION / 空间导航</h2><span style="font-size:12px;color:#929dab">模块由后台管理，增删改排自动生效</span></div>
    <HomeModules client:load initial={modules} base={base} />
  </section>

  <section class="section reveal-group">
    <div class="section-head" data-ghost="DATA"><h2>SITE DATA / 真实数据</h2></div>
    <div class="stats-row">
      <div class="stat-cell glass-panel" data-reveal style="--i:0"><div class="stat-num" data-count={allPosts.length}>{allPosts.length}</div><div class="stat-key">Total Articles</div><div class="stat-sub">已发布文章</div></div>
      <div class="stat-cell glass-panel" data-reveal style="--i:1"><div class="stat-num purple" id="stat-bookmarks-num" data-count={bookmarkCount ?? undefined}>{bookmarkCount ?? "—"}</div><div class="stat-key">Bookmarks</div><div class="stat-sub">公开书签</div></div>
      <div class="stat-cell glass-panel" data-reveal style="--i:2"><div class="stat-num green" data-count={modules.length}>{modules.length}</div><div class="stat-key">Modules</div><div class="stat-sub">首页模块</div></div>
      <div class="stat-cell glass-panel" data-reveal style="--i:3"><div class="stat-num">{lastUpdate ? lastUpdate.toLocaleDateString("zh-CN") : "—"}</div><div class="stat-key">Last Update</div><div class="stat-sub">最近更新</div></div>
    </div>
  </section>

  <section class="section reveal-group">
    <div class="section-head" data-ghost="SIGNALS"><h2>01 / LATEST TRANSMISSIONS</h2><a href={`${base}blog/`}>VIEW ALL ↗</a></div>
    {posts.length ? <div class="card-grid bento-grid">
      {posts.map((post, i) => <a class="card" data-tilt data-reveal style={`--i:${i}`} href={`${base}blog/${post.slug}/`}>
        <div class="card-kicker">{post.data.category} · {post.data.pubDate.toLocaleDateString("zh-CN")}</div>
        <h3>{post.data.title}</h3><p>{post.data.description}</p>
      </a>)}
    </div> : <div class="empty-state">还没有发布文章。<br/>在 <code>src/content/blog/</code> 添加 Markdown 文件即可开始。</div>}
  </section>

  <section class="section reveal-group">
    <div class="section-head" data-ghost="PROJECTS"><h2>02 / RECENT PROJECTS</h2><a href={`${base}projects/`}>VIEW ALL ↗</a></div>
    {recentProjects.length ? <div class="card-grid bento-grid">
      {recentProjects.map((p, i) => <a class="card" data-tilt data-reveal style={`--i:${i}`} href={`${base}projects/`}>
        <div class="card-kicker">PROJECT · {p.status === "in_progress" ? "IN PROGRESS" : p.status === "completed" ? "COMPLETED" : "PLANNED"}</div>
        <h3>{p.name}</h3><p>{p.description}</p>
      </a>)}
    </div> : <div class="empty-state">还没有项目。<br/>在后台 → 项目管理中添加。</div>}
  </section>

  <section class="section reveal-group">
    <div class="section-head" data-ghost="BOOKMARKS"><h2>03 / LATEST BOOKMARKS</h2><a href={`${base}collection/`}>EXPLORE ALL ↗</a></div>
    <LatestBookmarks client:load initial={latestBookmarks} />
  </section>

  <section class="section reveal-group">
    <div class="section-head" data-ghost="CHANGELOG"><h2>04 / CHANGELOG</h2><a href={`${base}changelog/`}>VIEW ALL ↗</a></div>
    {changelog.length ? <div class="card-grid bento-grid">
      {changelog.map((c, i) => <a class="card" data-tilt data-reveal style={`--i:${i}`} href={`${base}changelog/`}>
        <div class="card-kicker">{c.version} · {new Date(c.published_at).toLocaleDateString("zh-CN")}</div>
        <h3>{c.title}</h3>
      </a>)}
    </div> : <div class="empty-state">还没有更新记录。<br/>在后台 → 更新日志管理中添加。</div>}
  </section>
  <Subscribe client:load />
</MainLayout>
