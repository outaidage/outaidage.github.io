---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<MainLayout title="文章 — OUTAI">
  <header class="page-head"><div class="eyebrow"><span class="pulse"></span> WRITING / NOTES</div><h1>文章与想法<span style="color:#b5f36b">.</span></h1><p>技术记录、工具体验、互联网观察，以及一些值得留下的思考。</p></header>
  <div class="section">
    {posts.length ? <div class="card-grid">{posts.map(post=><a class="card" href={`${import.meta.env.BASE_URL}blog/${post.slug}/`}>
      <div class="card-kicker">{post.data.category} · {post.data.pubDate.toLocaleDateString("zh-CN")}</div><h3>{post.data.title}</h3><p>{post.data.description}</p><div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:14px">{post.data.tags.map(t=><span class="tag">{t}</span>)}</div>
    </a>)}</div> : <div class="empty-state">暂无文章。</div>}
  </div>
</MainLayout>
