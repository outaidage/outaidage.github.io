---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import Subscribe from "@/components/Subscribe";
const posts = (await getCollection("blog", ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const categories = ["全部", ...Array.from(new Set(posts.map(p=>p.data.category).filter(Boolean)))];
function readingMinutes(body: string) {
  const chars = body.replace(/\s/g, "").length;
  return Math.max(1, Math.ceil(chars / 400));
}
---
<MainLayout title="文章 — OUTAI">
  <header class="page-head"><div class="eyebrow"><span class="pulse"></span> WRITING / NOTES</div><h1>文章与想法<span style="color:#61edff">.</span></h1><p>技术记录、工具体验、互联网观察，以及一些值得留下的思考。</p></header>
  <div class="toolbar">
    <input class="field" id="blog-search" type="search" placeholder="搜索标题、描述或标签…" aria-label="搜索文章" />
  </div>
  <div class="filter-chips" role="group" aria-label="按分类筛选">
    {categories.map(c=><button type="button" class="chip" data-cat-filter={c} aria-pressed={c==="全部"}>{c}</button>)}
  </div>
  <div class="section">
    {posts.length ? <div class="card-grid">
      {posts.map(post=>{
        const searchText = `${post.data.title} ${post.data.description} ${(post.data.tags||[]).join(" ")}`.toLowerCase();
        return <a class="card" data-tilt data-post-card data-category={post.data.category} data-search={searchText} href={`${import.meta.env.BASE_URL}blog/${post.slug}/`}>
          {post.data.cover && <img class="card-cover" src={post.data.cover} alt="" loading="lazy" />}
          <div class="card-kicker">{post.data.category} · {post.data.pubDate.toLocaleDateString("zh-CN")} · 约 {readingMinutes(post.body)} 分钟{post.data.featured ? " · 精选" : ""}</div>
          <h3>{post.data.title}</h3><p>{post.data.description}</p>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:14px">{(post.data.tags||[]).filter(t=>t && t.trim()).map(t=><span class="tag">{t}</span>)}</div>
        </a>;
      })}
    </div> : <div class="empty-state">暂无文章。</div>}
    <div class="empty-state" id="blog-empty" style="display:none">没有符合条件的文章，换个关键词或分类试试。</div>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById("blog-search");
      var chips = Array.prototype.slice.call(document.querySelectorAll("[data-cat-filter]"));
      var cards = Array.prototype.slice.call(document.querySelectorAll("[data-post-card]"));
      var empty = document.getElementById("blog-empty");
      var activeCat = "全部";
      function apply() {
        var needle = (q.value || "").toLowerCase().trim();
        var shown = 0;
        cards.forEach(function (card) {
          var okCat = activeCat === "全部" || card.getAttribute("data-category") === activeCat;
          var okQ = !needle || (card.getAttribute("data-search") || "").indexOf(needle) !== -1;
          var show = okCat && okQ;
          card.style.display = show ? "" : "none";
          if (show) shown++;
        });
        if (empty) empty.style.display = shown ? "none" : "";
      }
      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          activeCat = chip.getAttribute("data-cat-filter") || "全部";
          chips.forEach(function (c) {
            var on = c === chip;
            c.classList.toggle("active", on);
            c.setAttribute("aria-pressed", on ? "true" : "false");
          });
          apply();
        });
      });
      if (q) q.addEventListener("input", apply);
    })();
  </script>
  <Subscribe client:load />
</MainLayout>
