---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({data}) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<MainLayout title={`${post.data.title} — OUTAI`} description={post.data.description}>
  <header class="page-head"><div class="eyebrow"><span class="pulse"></span> {post.data.category} / {post.data.pubDate.toLocaleDateString("zh-CN")}</div><h1>{post.data.title}</h1><p>{post.data.description}</p></header>
  <article class="article-body"><Content /></article>
</MainLayout>
