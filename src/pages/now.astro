---
import MainLayout from "@/layouts/MainLayout.astro";
import { getPageContent } from "@/lib/page-content";

// Now 页内容由后台「页面内容」管理（page_content 表 id='now'），
// 失败或缺失时回落内置默认值。
const page = await getPageContent("now");
---
<MainLayout title="Now — OUTAI">
  <header class="page-head" data-ghost="NOW"><div class="eyebrow"><span class="pulse"></span> NOW / CURRENTLY</div><h1>{page.title.replace(/\.$/, "")}</h1><p>{page.subtitle}</p></header>
  <div class="card-grid">
    {page.items.map((it) => (
      <div class="card"><div class="card-kicker">{it.kicker ?? ""}</div><h3>{it.title ?? ""}</h3><p>{it.description ?? ""}</p></div>
    ))}
  </div>
</MainLayout>
