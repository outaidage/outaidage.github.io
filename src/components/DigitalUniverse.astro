---
// DigitalUniverse.astro — OUTAI digital universe background.
// Fixed behind all content (z-index -1, pointer-events none), never covers text
// or navigation. Layers, back to front:
//   1. radial glow (CSS, brand green, very low opacity)
//   2. perspective grid (CSS linear-gradient, slow drift)
//   3. particle canvas (src/lib/universe-canvas.ts, vanilla 2D canvas)
// The canvas only starts when motion is allowed (prefers-reduced-motion and
// the footer motion toggle both gate it); the grid + glow are static when
// motion is off.
import { initUniverse } from "../lib/universe-canvas";
---

<div class="universe" aria-hidden="true">
  <div class="universe-glow"></div>
  <div class="universe-grid"></div>
  <canvas id="universe-canvas"></canvas>
</div>

<script>
  import { initUniverse } from "../lib/universe-canvas";
  const canvas = document.getElementById("universe-canvas");
  if (canvas instanceof HTMLCanvasElement) {
    initUniverse(canvas);
  }
</script>

<style>
  .universe {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .universe-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 75% 0%, rgba(181, 243, 107, 0.10), transparent 60%),
      radial-gradient(ellipse 45% 35% at 12% 85%, rgba(181, 243, 107, 0.05), transparent 60%);
  }
  .universe-grid {
    position: absolute;
    inset: -40px 0 0 0;
    background-image:
      linear-gradient(rgba(181, 243, 107, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(181, 243, 107, 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    transform: perspective(600px) rotateX(42deg) scale(1.6);
    transform-origin: center top;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent 78%);
    animation: universe-grid-drift 24s linear infinite;
  }
  @keyframes universe-grid-drift {
    from { background-position-y: 0; }
    to { background-position-y: 56px; }
  }
  #universe-canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .universe-grid { animation: none; }
  }
  html[data-motion="reduced"] .universe-grid { animation: none; }
</style>
