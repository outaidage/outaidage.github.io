---
// DigitalUniverse.astro — OUTAI digital universe background.
// Fixed behind all content (z-index 0; .site-shell sits above at z-index 1),
// pointer-events none, never covers text or navigation. Layers, back to front:
//   1. radial glow (CSS, energy cyan, very low opacity)
//   2. flat grid (CSS linear-gradient, slow drift, subtle)
//   3. particle canvas (src/lib/universe-canvas.ts, vanilla 2D canvas)
// The canvas is initialised from MainLayout (module script, astro:page-load),
// because a <script> in this component is not reliably bundled by Astro.
// The canvas only starts when motion is allowed (prefers-reduced-motion and
// the footer motion toggle both gate it); the grid + glow are static when
// motion is off.
---

<div class="universe" aria-hidden="true">
  <div class="universe-glow"></div>
  <div class="universe-grid"></div>
  <canvas id="universe-canvas"></canvas>
</div>

<style>
  .universe {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .universe-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 75% 0%, rgba(97, 237, 255, 0.10), transparent 60%),
      radial-gradient(ellipse 45% 35% at 12% 85%, rgba(166, 138, 255, 0.06), transparent 60%);
  }
  .universe-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(97, 237, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(97, 237, 255, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, rgba(0, 0, 0, 0.9), transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, rgba(0, 0, 0, 0.9), transparent 100%);
    animation: universe-grid-drift 24s linear infinite;
  }
  @keyframes universe-grid-drift {
    from { background-position-y: 0; }
    to { background-position-y: 56px; }
  }
  #universe-canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .universe-grid { animation: none; }
  }
  html[data-motion="reduced"] .universe-grid { animation: none; }
</style>
