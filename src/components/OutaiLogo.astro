---
// OutaiLogo.astro — the OUTAI brand mark (original design, no third-party logo).
// A hexagon orbit ring with an inner orbit arc (the "O") and a satellite dot.
// Energy cyan stroke, subtle glow. Entrance: stroke-draw animation.
// Hover: glow strengthens and the mark tilts slightly.
// Props: size (px), withWordmark (show "OUTAI." text next to the mark).
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 32, withWordmark = false } = Astro.props;
---

<span class="outai-logo" style={`--logo-size:${size}px`} role="img" aria-label="OUTAI">
  <svg class="outai-logo-mark" viewBox="0 0 64 64" width={size} height={size} fill="none" aria-hidden="true">
    <path class="outai-logo-hex" d="M32 6 L54.5 19 L54.5 45 L32 58 L9.5 45 L9.5 19 Z" stroke="#61edff" stroke-width="2.5" stroke-linejoin="round" />
    <path class="outai-logo-orbit" d="M19.8 27.6 A13 13 0 1 1 44.2 27.6" stroke="#61edff" stroke-width="3" stroke-linecap="round" />
    <circle class="outai-logo-dot" cx="44.2" cy="27.6" r="3.2" fill="#61edff" />
  </svg>
  {withWordmark && <span class="outai-logo-word">OUTAI<span class="brand-dot">.</span></span>}
</span>

<style>
  .outai-logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    line-height: 1;
  }
  .outai-logo-mark {
    filter: drop-shadow(0 0 6px rgba(97, 237, 255, 0.35));
    transition: filter 0.25s ease, transform 0.25s ease;
  }
  .outai-logo:hover .outai-logo-mark {
    filter: drop-shadow(0 0 12px rgba(97, 237, 255, 0.65));
    transform: rotate(-6deg);
  }
  .outai-logo-hex {
    stroke-dasharray: 156;
    stroke-dashoffset: 156;
    animation: outai-draw 1.1s ease-out 0.05s forwards;
  }
  .outai-logo-orbit {
    stroke-dasharray: 50;
    stroke-dashoffset: 50;
    animation: outai-draw 0.9s ease-out 0.35s forwards;
  }
  .outai-logo-dot {
    opacity: 0;
    animation: outai-fade 0.4s ease-out 1.1s forwards;
  }
  @keyframes outai-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes outai-fade {
    to { opacity: 1; }
  }
  .outai-logo-word {
    font-weight: 800;
    letter-spacing: 0.12em;
    font-size: 15px;
    color: #eef1f5;
  }
  .brand-dot { color: #61edff; }
  @media (prefers-reduced-motion: reduce) {
    .outai-logo-hex, .outai-logo-orbit { animation: none; stroke-dashoffset: 0; }
    .outai-logo-dot { animation: none; opacity: 1; }
    .outai-logo-mark { transition: none; }
  }
  html[data-motion="reduced"] .outai-logo-hex,
  html[data-motion="reduced"] .outai-logo-orbit { animation: none; stroke-dashoffset: 0; }
  html[data-motion="reduced"] .outai-logo-dot { animation: none; opacity: 1; }
  html[data-motion="reduced"] .outai-logo-mark { transition: none; }
</style>
