---
// BootIntro.astro — OUTAI 全息启动动画（OUTAI CINEMATIC BOOT）。
// 只在首页渲染。遮罩默认隐藏（display:none），内联脚本在解析时同步决定
// 是否播放：要播放时立即显示（第一帧就是黑屏+光点），不播放时保持隐藏。
// 关键：视图切换（Astro 客户端导航）回首页时，ES 模块脚本不会重新执行，
// 内联脚本也可能不重新执行——默认隐藏能保证遮罩绝不盖住屏幕黑屏卡死。
// 无 JS 时 <noscript> 直接隐藏，绝不挡住网站。
// 播放规则：首次访问完整播放；同一会话再次访问跳过；可跳过、可永久关闭、可重播；
// 音效默认关闭（WebAudio 合成，原创）；手机端缩短；支持 prefers-reduced-motion。
---

<div id="boot-intro" class="boot-intro" role="dialog" aria-label="OUTAI 启动动画" aria-hidden="true">
  <canvas id="boot-stars" class="boot-stars" aria-hidden="true"></canvas>
  <div class="boot-point" aria-hidden="true"></div>
  <div class="boot-rings" aria-hidden="true">
    <span class="boot-ring r1"></span>
    <span class="boot-ring r2"></span>
    <span class="boot-ring r3"></span>
    <span class="boot-scan"></span>
  </div>
  <div class="boot-lines" aria-hidden="true">
    <p class="boot-line">SYSTEM INITIALIZING</p>
    <p class="boot-line">NEURAL NETWORK ONLINE</p>
    <p class="boot-line">UNIVERSE ENGINE READY</p>
    <p class="boot-line">WELCOME TO OUTAI</p>
  </div>
  <div class="boot-brand" aria-hidden="true">
    <div class="boot-pulse"></div>
    <div class="boot-word">OUTAI</div>
    <div class="boot-sub">PERSONAL DIGITAL UNIVERSE</div>
  </div>
  <div class="boot-controls">
    <button id="boot-sound" type="button" aria-pressed="false">音效：关</button>
    <button id="boot-never" type="button">不再显示</button>
    <button id="boot-skip" type="button">SKIP INTRO →</button>
  </div>
</div>
<noscript><style>#boot-intro { display: none !important; }</style></noscript>
<script is:inline>
  // 同步决定：不播放时在解析阶段就隐藏遮罩，避免首屏闪烁。
  (function () {
    var overlay = document.getElementById("boot-intro");
    if (!overlay) return;
    var play = true;
    try {
      var replay = sessionStorage.getItem("outai-boot-replay") === "1";
      if (replay) {
        play = true; // 一次性重播优先于"不再显示"，但不优先于减弱动效
      } else if (localStorage.getItem("outai-boot") === "off") play = false;
      else if (sessionStorage.getItem("outai-boot-shown") === "1") play = false;
      if (document.documentElement.dataset.motion === "reduced") play = false;
      else if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) play = false;
    } catch (e) {}
    window.__outaiBoot = { play: play };
    // 默认隐藏（CSS display:none）；要播放时同步显示，避免首屏闪烁；
    // 不播放时保持隐藏。视图切换回首页时脚本可能不重新执行，
    // 默认隐藏能保证遮罩绝不盖住屏幕。
    overlay.style.display = play ? "flex" : "none";
  })();
</script>
<script>
  import gsap from "gsap";
  import { playBootSound } from "@/lib/boot-sound";

  (function () {
    const overlay = document.getElementById("boot-intro");
    if (!overlay) return;
    const flag = (window as unknown as { __outaiBoot?: { play?: boolean } }).__outaiBoot;
    if (!flag || !flag.play) {
      // 不播放时直接隐藏遮罩（不依赖内联脚本是否执行过——视图切换回首页时
      // 内联脚本可能不重新执行，遮罩若留着会一直盖住屏幕黑屏）。
      overlay.style.display = "none";
      window.dispatchEvent(new CustomEvent("outai:boot-done"));
      return;
    }
    overlay.removeAttribute("aria-hidden");
    // 确保遮罩可见（内联脚本若未执行，默认是隐藏的；这里再显式打开）。
    overlay.style.display = "flex";
    overlay.style.opacity = "1";

    const isMobile = window.innerWidth < 760;
    const D = isMobile ? 0.62 : 1; // 手机端缩短
    const soundOn = (() => {
      try { return localStorage.getItem("outai-boot-sound") === "on"; } catch { return false; }
    })();
    let finished = false;
    let raf = 0;

    // 星尘画布：120 颗星缓慢漂移+闪烁，动画结束即停止。
    const canvas = document.getElementById("boot-stars") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d") ?? null;
    const stars: { x: number; y: number; r: number; p: number; s: number }[] = [];
    if (canvas && ctx) {
      const w = (canvas.width = window.innerWidth);
      const h = (canvas.height = window.innerHeight);
      let seed = 20261114;
      const rnd = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; };
      for (let i = 0; i < 120; i++) {
        stars.push({ x: rnd() * w, y: rnd() * h, r: 0.4 + rnd() * 1.4, p: rnd() * Math.PI * 2, s: 0.4 + rnd() * 1.2 });
      }
      const draw = (t: number) => {
        if (finished) return;
        ctx.clearRect(0, 0, w, h);
        for (const st of stars) {
          const a = 0.25 + 0.55 * Math.abs(Math.sin(t * 0.0006 * st.s + st.p));
          ctx.globalAlpha = a;
          ctx.fillStyle = st.r > 1.2 ? "#a68aff" : "#61edff";
          ctx.beginPath();
          ctx.arc(st.x, st.y + Math.sin(t * 0.00008 * st.s + st.p) * 6, st.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      };
      raf = requestAnimationFrame(draw);
    }

    const soundBtn = document.getElementById("boot-sound");
    const syncSoundLabel = () => {
      const on = (() => { try { return localStorage.getItem("outai-boot-sound") === "on"; } catch { return false; } })();
      if (soundBtn) {
        soundBtn.textContent = on ? "音效：开" : "音效：关";
        soundBtn.setAttribute("aria-pressed", on ? "true" : "false");
      }
      return on;
    };
    syncSoundLabel();
    if (soundOn) playBootSound();
    soundBtn?.addEventListener("click", () => {
      const next = !syncSoundLabel();
      try { localStorage.setItem("outai-boot-sound", next ? "on" : "off"); } catch { /* ignore */ }
      syncSoundLabel();
      if (next) playBootSound();
    });

    const finish = () => {
      if (finished) return;
      finished = true;
      cancelAnimationFrame(raf);
      try { sessionStorage.setItem("outai-boot-shown", "1"); } catch { /* ignore */ }
      try { sessionStorage.removeItem("outai-boot-replay"); } catch { /* ignore */ }
      overlay.style.display = "none";
      window.dispatchEvent(new CustomEvent("outai:boot-done"));
    };

    let tl: gsap.core.Timeline | null = null;
    try {
      tl = gsap.timeline({ onComplete: finish });
      tl.fromTo(".boot-point", { scale: 1, opacity: 1 }, { scale: 22, opacity: 0.85, duration: 0.9 * D, ease: "power2.out" }, 0)
        .fromTo(".boot-stars", { opacity: 0 }, { opacity: 1, duration: 1.2 * D }, 0.1)
        .fromTo(".boot-ring", { scale: 0.55, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.7 * D, stagger: 0.15 * D, ease: "power2.out" }, 0.7)
        .fromTo(".boot-line", { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.35 * D, stagger: 0.3 * D }, 1.2)
        .to(".boot-lines", { opacity: 0, duration: 0.4 * D }, 2.6)
        .to(".boot-rings", { opacity: 0, scale: 1.15, duration: 0.5 * D, ease: "power2.in" }, 2.6)
        .fromTo(".boot-brand", { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.7 * D, ease: "power2.out" }, 2.8)
        .fromTo(".boot-pulse", { scale: 0.4, opacity: 0.7 }, { scale: 2.4, opacity: 0, duration: 0.9 * D, ease: "power2.out" }, 3.0)
        .fromTo(".boot-sub", { opacity: 0 }, { opacity: 1, duration: 0.5 * D }, 3.3)
        .to(overlay, { opacity: 0, duration: 0.6 * D, ease: "power1.inOut" }, 4.4);
    } catch {
      finish();
    }

    const skip = () => {
      tl?.kill();
      gsap.to(overlay, { opacity: 0, duration: 0.3, onComplete: finish });
    };
    document.getElementById("boot-skip")?.addEventListener("click", skip);
    document.getElementById("boot-never")?.addEventListener("click", () => {
      try { localStorage.setItem("outai-boot", "off"); } catch { /* ignore */ }
      skip();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !finished) skip();
    });
    // 安全兜底：万一 GSAP 时间轴卡住，7 秒后强制结束，绝不黑屏卡死。
    window.setTimeout(() => { if (!finished) { tl?.kill(); finish(); } }, 7000);
  })();
</script>
<style>
  .boot-intro {
    position: fixed; inset: 0; z-index: 400;
    background: #03040b;
    /* 默认隐藏：只有 JS 明确决定播放时才显示。视图切换回首页时脚本
       可能不重新执行，默认隐藏能保证遮罩绝不黑屏盖住网站。 */
    display: none; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .boot-stars { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .boot-point {
    position: absolute; left: 50%; top: 50%;
    width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
    background: radial-gradient(circle, #dff8ff 0%, #61edff 40%, rgba(97, 237, 255, 0) 70%);
    box-shadow: 0 0 24px 6px rgba(97, 237, 255, 0.55);
  }
  .boot-rings { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
  .boot-ring {
    position: absolute; border-radius: 50%; opacity: 0;
    border: 1px solid rgba(97, 237, 255, 0.55);
    box-shadow: 0 0 18px rgba(97, 237, 255, 0.25), inset 0 0 18px rgba(97, 237, 255, 0.12);
  }
  .boot-ring.r1 { width: 220px; height: 220px; margin: -110px 0 0 -110px; animation: boot-spin 14s linear infinite; }
  .boot-ring.r2 { width: 300px; height: 300px; margin: -150px 0 0 -150px; border-color: rgba(166, 138, 255, 0.5); border-style: dashed; animation: boot-spin-rev 20s linear infinite; }
  .boot-ring.r3 { width: 380px; height: 380px; margin: -190px 0 0 -190px; border-color: rgba(125, 255, 206, 0.35); animation: boot-spin 28s linear infinite; }
  .boot-scan {
    position: absolute; left: -190px; top: -190px; width: 380px; height: 2px;
    background: linear-gradient(90deg, transparent, rgba(97, 237, 255, 0.9), transparent);
    animation: boot-scan 1.6s ease-in-out infinite alternate;
  }
  @keyframes boot-spin { to { transform: rotate(360deg); } }
  @keyframes boot-spin-rev { to { transform: rotate(-360deg); } }
  @keyframes boot-scan { from { transform: translateY(0); opacity: 0.4; } to { transform: translateY(380px); opacity: 1; } }
  .boot-lines {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    margin-top: 210px; text-align: center;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px; letter-spacing: 0.32em; color: rgba(97, 237, 255, 0.75);
  }
  .boot-line { opacity: 0; margin: 6px 0; }
  .boot-brand { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); text-align: center; opacity: 0; }
  .boot-pulse {
    position: absolute; left: 50%; top: 50%; width: 320px; height: 320px;
    margin: -160px 0 0 -160px; border-radius: 50%; opacity: 0;
    background: radial-gradient(circle, rgba(97, 237, 255, 0.35) 0%, rgba(166, 138, 255, 0.18) 45%, transparent 70%);
  }
  .boot-word {
    position: relative;
    font-size: clamp(56px, 14vw, 128px); font-weight: 800; letter-spacing: 0.18em;
    line-height: 1; color: #f2fbff;
    background: linear-gradient(100deg, #dff8ff 10%, #61edff 45%, #a68aff 75%, #7dffce 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    text-shadow: 0 0 42px rgba(97, 237, 255, 0.35);
  }
  .boot-sub {
    position: relative; margin-top: 18px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px; letter-spacing: 0.42em; color: rgba(214, 240, 255, 0.72);
  }
  .boot-controls {
    position: absolute; left: 0; right: 0; bottom: 28px;
    display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; padding: 0 16px;
  }
  .boot-controls button {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px; letter-spacing: 0.18em;
    color: rgba(214, 240, 255, 0.85);
    background: rgba(97, 237, 255, 0.06);
    border: 1px solid rgba(97, 237, 255, 0.28); border-radius: 999px;
    padding: 8px 16px; cursor: pointer;
  }
  .boot-controls button:hover { background: rgba(97, 237, 255, 0.16); border-color: rgba(97, 237, 255, 0.6); }
  #boot-skip { border-color: rgba(166, 138, 255, 0.55); color: #e6dcff; }
  @media (max-width: 760px) {
    .boot-lines { margin-top: 170px; font-size: 10px; }
    .boot-ring.r1 { width: 170px; height: 170px; margin: -85px 0 0 -85px; }
    .boot-ring.r2 { width: 230px; height: 230px; margin: -115px 0 0 -115px; }
    .boot-ring.r3 { width: 290px; height: 290px; margin: -145px 0 0 -145px; }
    .boot-scan { left: -145px; top: -145px; width: 290px; }
    @keyframes boot-scan { from { transform: translateY(0); opacity: 0.4; } to { transform: translateY(290px); opacity: 1; } }
  }
</style>
