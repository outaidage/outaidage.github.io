---
// BootIntro.astro — OUTAI 电影级开场（CINEMATIC BOOT）。
// 透明遮罩：3D 场景透过遮罩可见，镜头在现有太阳系场景内连续飞行
// （深空星云 → 掠过木星、土星 → 太阳能量核心 → 无缝进入现有总览），
// 不新建场景、不换页、不黑屏。OUTAI 品牌（字标 + PERSONAL DIGITAL
// UNIVERSE）是 DOM 覆盖层，在能量核心时淡入、进入主场景时淡出。
// 舞台在开场期间全屏（复用 universe-full，与“进入宇宙”同一机制），
// 结束时 FLIP 收回嵌入位置（transform 缩放+位移，平滑不闪黑）。
// 播放规则：首次访问完整播放；同一会话再次访问跳过；可跳过、可永久
// 关闭、可重播；音效默认关闭（WebAudio 合成，原创）；手机端缩短；
// 支持 prefers-reduced-motion。遮罩默认隐藏（display:none），内联脚本
// 在解析时同步决定是否播放。视图切换回首页时 ES 模块脚本不会重新执行，
// 默认隐藏能保证遮罩绝不盖住屏幕黑屏卡死。无 JS 时 <noscript> 直接隐藏。
---

<div id="boot-intro" class="boot-intro" role="dialog" aria-label="OUTAI 启动动画" aria-hidden="true" style="display:none; position:fixed; inset:0; z-index:400; background:#03040b; overflow:hidden; pointer-events:auto;">
  <div class="boot-brand" aria-hidden="true">
    <div class="boot-pulse"></div>
    <div class="boot-word">OUTAI</div>
    <div class="boot-sub">PERSONAL DIGITAL UNIVERSE</div>
  </div>
  <div class="boot-controls">
    <button id="boot-sound" type="button" aria-pressed="false">音效：关</button>
    <button id="boot-never" type="button">不再显示</button>
    <button id="boot-skip" type="button">SKIP INTRO →</button>
  </div>
</div>
<noscript><style>#boot-intro { display: none !important; }</style></noscript>
<script is:inline>
  // 同步决定：不播放时在解析阶段就隐藏遮罩，避免首屏闪烁。
  (function () {
    var overlay = document.getElementById("boot-intro");
    if (!overlay) return;
    var play = true;
    try {
      var replay = sessionStorage.getItem("outai-boot-replay") === "1";
      if (replay) {
        play = true; // 一次性重播优先于"不再显示"，但不优先于减弱动效
      } else if (localStorage.getItem("outai-boot") === "off") play = false;
      else if (sessionStorage.getItem("outai-boot-shown") === "1") play = false;
      if (document.documentElement.dataset.motion === "reduced") play = false;
      // 注意：这里只认站内动效开关（dataset.motion），不认操作系统的
      // prefers-reduced-motion。站内开关才是用户明确的选择：用户把动效
      // 设为“开”，开场就该放。之前这里还有一条 matchMedia 兜底，会在
      // Windows 开启“减弱动效”时直接不播放，导致电脑上 Edge 和 Chrome
      // 都没有开场（手机没开系统减弱动效所以能放），2026-11-15 11:20 JST
      // 用户反馈后已删掉该条——与视频背景的修复（PR #41）是同一个根因。
    } catch (e) {}
    window.__outaiBoot = { play: play };
    // 默认隐藏（CSS display:none）；要播放时同步显示；不播放时保持隐藏。
    // 视图切换回首页时脚本可能不重新执行，默认隐藏能保证遮罩绝不黑屏盖住网站。
    overlay.style.display = play ? "flex" : "none";
  })();
</script>
<script>
  import gsap from "gsap";
  import { playBootSound } from "@/lib/boot-sound";
  // 事件名与 SpaceCore.tsx 内的常量字面量一致（不从 @/lib/boot-flight
  // 导入——该模块在岛屿打包时未被正确内联，引用会成自由变量）。
  const BOOT_FLY = "outai:boot-fly";
  const BOOT_CORE = "outai:boot-core";
  const BOOT_ENTER = "outai:boot-enter";
  const BOOT_CAMERA_DONE = "outai:boot-camera-done";
  const BOOT_SKIP = "outai:boot-skip";
  const SCENE_READY = "outai:scene-ready";

  (function () {
    const overlay = document.getElementById("boot-intro");
    if (!overlay) return;
    const flag = (window as unknown as { __outaiBoot?: { play?: boolean } }).__outaiBoot;
    if (!flag || !flag.play) {
      // 不播放时直接隐藏遮罩（不依赖内联脚本是否执行过——视图切换回首页时
      // 内联脚本可能不重新执行，遮罩若留着会一直盖住屏幕黑屏）。
      overlay.style.display = "none";
      window.dispatchEvent(new CustomEvent("outai:boot-done"));
      return;
    }
    overlay.removeAttribute("aria-hidden");
    // 确保遮罩可见（内联脚本若未执行，默认是隐藏的；这里再显式打开）。
    overlay.style.display = "flex";
    overlay.style.opacity = "1";

    const stage = document.getElementById("core-stage");
    const brand = overlay.querySelector(".boot-brand") as HTMLElement | null;
    const isMobile = window.innerWidth < 760;
    let finished = false;

    // 音效（默认关；WebAudio 合成，原创；只在用户开启后播放）
    const soundOn = (() => {
      try { return localStorage.getItem("outai-boot-sound") === "on"; } catch { return false; }
    })();
    const soundBtn = document.getElementById("boot-sound");
    const syncSoundLabel = () => {
      const on = (() => { try { return localStorage.getItem("outai-boot-sound") === "on"; } catch { return false; } })();
      if (soundBtn) {
        soundBtn.textContent = on ? "音效：开" : "音效：关";
        soundBtn.setAttribute("aria-pressed", on ? "true" : "false");
      }
      return on;
    };
    syncSoundLabel();
    soundBtn?.addEventListener("click", () => {
      const next = !syncSoundLabel();
      try { localStorage.setItem("outai-boot-sound", next ? "on" : "off"); } catch { /* ignore */ }
      syncSoundLabel();
      if (next) playBootSound();
    });

    const finish = () => {
      if (finished) return;
      finished = true;
      try { sessionStorage.setItem("outai-boot-shown", "1"); } catch { /* ignore */ }
      try { sessionStorage.removeItem("outai-boot-replay"); } catch { /* ignore */ }
      overlay.style.display = "none";
      window.dispatchEvent(new CustomEvent("outai:boot-done"));
    };

    // 起飞后遮罩变透明（3D 飞行透过遮罩可见）。起飞前遮罩是不透明深空底，
    // 盖住等待期的嵌入式首页，否则首页会先闪一下、再突然切入场动画。
    // 底色与定位用 div 上的内联 style（不靠打包 CSS）：页面首次绘制时
    // 外部 CSS 可能还没加载完，内联样式随元素解析立即生效，首帧就有
    // 不透明底盖住首页；这里同步改内联样式（内联样式优先级高于
    // .boot-flying 类，类选择器改不动它）。
    const revealScene = () => {
      overlay.classList.add("boot-flying");
      overlay.style.background = "transparent";
      overlay.style.pointerEvents = "none";
    };

    // 舞台全屏（复用 universe-full，与“进入宇宙”同一机制：同一个
    // Canvas/场景全屏展开，不重建场景、不换页）。
    const enterFullscreen = () => {
      if (!stage) return;
      stage.classList.add("universe-full");
      document.body.classList.add("universe-open");
    };
    // FLIP：舞台从全屏平滑收回嵌入位置。先量全屏与嵌入两个矩形，把舞台
    // 钉在全屏位置（视觉上保持全屏），再用 transform 缩放+位移 tween 到
    // 嵌入位置，结束时清除固定定位回到正常流。整个过程不闪黑（舞台始终可见）。
    const flipToEmbedded = (dur: number) => {
      if (!stage) return;
      const full = stage.getBoundingClientRect();
      stage.classList.remove("universe-full");
      document.body.classList.remove("universe-open");
      const emb = stage.getBoundingClientRect();
      if (full.width <= 0 || emb.width <= 0) return; // 量不到矩形时直接收回，不卡住
      stage.style.position = "fixed";
      stage.style.left = `${full.left}px`;
      stage.style.top = `${full.top}px`;
      stage.style.width = `${full.width}px`;
      stage.style.height = `${full.height}px`;
      stage.style.margin = "0";
      stage.style.zIndex = "200";
      stage.style.borderRadius = "0px";
      stage.style.transformOrigin = "top left";
      const dx = emb.left - full.left;
      const dy = emb.top - full.top;
      const sx = emb.width / full.width;
      const sy = emb.height / full.height;
      gsap.to(stage, {
        x: dx, y: dy, scaleX: sx, scaleY: sy, borderRadius: "16px",
        duration: dur, ease: "power2.inOut",
        onComplete: () => {
          stage.style.position = ""; stage.style.left = ""; stage.style.top = "";
          stage.style.width = ""; stage.style.height = ""; stage.style.margin = "";
          stage.style.zIndex = ""; stage.style.borderRadius = "";
          gsap.set(stage, { clearProps: "transform" });
        },
      });
    };

    // 到达能量核心：品牌淡入（字标微放 + 光晕扩散，冰蓝/青紫光效）。
    // 淡入要快（0.5s），太阳还在画面中央时品牌就已清晰可见。
    const onCore = () => {
      if (!brand) return;
      gsap.to(brand, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" });
      const pulse = brand.querySelector(".boot-pulse");
      if (pulse) gsap.fromTo(pulse, { scale: 0.4, opacity: 0.7 }, { scale: 2.4, opacity: 0, duration: 1.2, ease: "power2.out" });
    };
    // 进入主场景：品牌淡出 + 舞台收回嵌入位置（与镜头进入总览同步）。
    const onEnter = () => {
      if (brand) gsap.to(brand, { opacity: 0, duration: 0.5, ease: "power1.inOut" });
      flipToEmbedded(isMobile ? 0.7 : 0.9);
    };
    // 相机到达总览 → 结束开场。
    const onCameraDone = () => { finish(); };

    window.addEventListener(BOOT_CORE, onCore);
    window.addEventListener(BOOT_ENTER, onEnter);
    window.addEventListener(BOOT_CAMERA_DONE, onCameraDone);

    const skip = () => {
      if (finished) return;
      window.removeEventListener(BOOT_CORE, onCore);
      window.removeEventListener(BOOT_ENTER, onEnter);
      window.removeEventListener(BOOT_CAMERA_DONE, onCameraDone);
      // 跳过时也先让遮罩变透明（等待期内遮罩是不透明底；不先变透明，
      // 跳过后的 400ms 里用户会看到黑屏而不是首页）。
      revealScene();
      // 通知 3D 相机立即贴到总览（不再飞行）
      window.dispatchEvent(new CustomEvent(BOOT_SKIP));
      if (brand) { gsap.killTweensOf(brand); gsap.set(brand, { opacity: 0 }); }
      flipToEmbedded(0.35);
      // 快速收尾（不等相机，0.4 秒后结束）
      window.setTimeout(finish, 400);
    };
    document.getElementById("boot-skip")?.addEventListener("click", skip);
    document.getElementById("boot-never")?.addEventListener("click", () => {
      try { localStorage.setItem("outai-boot", "off"); } catch { /* ignore */ }
      skip();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !finished) skip();
    });
    // 安全兜底：万一飞行/事件卡住，8 秒后强制结束，绝不黑屏卡死。
    window.setTimeout(() => { if (!finished) skip(); }, 8000);

    // 启动：等 3D 场景渲染出第一帧再全屏+起飞（避免全屏后长时间黑屏）。
    // 场景通常在挂载后很快就绪；2.5 秒超时兜底（超时也继续，不卡住）。
    // 等待期间页面是正常首页（非全屏、无黑屏），舞台全屏时 3D 已可见。
    let started = false;
    const start = () => {
      if (started || finished) return;
      started = true;
      // 起飞前遮罩是不透明深空底（盖住等待期的首页）；起飞时变透明，
      // 3D 飞行透过遮罩可见，舞台全屏后不再是黑屏起手。
      revealScene();
      enterFullscreen();
      (window as unknown as { __outaiBootFly?: boolean }).__outaiBootFly = true;
      window.dispatchEvent(new CustomEvent(BOOT_FLY));
      if (soundOn) playBootSound();
    };
    window.addEventListener(SCENE_READY, start, { once: true });
    window.setTimeout(start, 2500);
  })();
</script>
<style>
  .boot-intro {
    position: fixed; inset: 0; z-index: 400;
    /* 起飞前是不透明深空底：等 3D 场景就绪期间（最长 2.5 秒），遮罩盖住
       嵌入式首页，否则首页会先闪一下、再突然切入场动画。起飞时加
       .boot-flying 变透明，3D 飞行透过遮罩可见。背景 0.4 秒过渡，避免
       从不透明到底色切换时闪一下。 */
    background: #03040b;
    transition: background-color 0.4s ease;
    /* 默认隐藏：只有 JS 明确决定播放时才显示。视图切换回首页时脚本
       可能不重新执行，默认隐藏能保证遮罩绝不黑屏盖住网站。 */
    display: none; align-items: center; justify-content: center;
    overflow: hidden;
    /* 等待期遮罩拦截点击（不让用户点到被盖住的首页）；起飞后放开，
       3D 画布可拖拽。控制按钮始终可点。 */
    pointer-events: auto;
  }
  /* 起飞后：遮罩变透明，3D 飞行透过遮罩可见；不再拦截点击。 */
  .boot-intro.boot-flying {
    background: transparent;
    pointer-events: none;
  }
  .boot-brand {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(0.94);
    text-align: center; opacity: 0;
    pointer-events: none;
  }
  /* 品牌背后的暗色径向底衬：无论背景是明亮的地球盘面还是太阳光晕，
     字标与副标题都有足够对比度，不会发虚看不清。 */
  .boot-brand::before {
    content: ""; position: absolute; left: 50%; top: 50%;
    width: 640px; height: 360px; margin: -180px 0 0 -320px; border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(3, 4, 11, 0.72) 0%, rgba(3, 4, 11, 0.38) 55%, rgba(3, 4, 11, 0) 78%);
    pointer-events: none;
  }
  .boot-pulse {
    position: absolute; left: 50%; top: 50%; width: 320px; height: 320px;
    margin: -160px 0 0 -160px; border-radius: 50%; opacity: 0;
    background: radial-gradient(circle, rgba(97, 237, 255, 0.35) 0%, rgba(166, 138, 255, 0.18) 45%, transparent 70%);
  }
  .boot-word {
    position: relative;
    font-size: clamp(56px, 14vw, 128px); font-weight: 800; letter-spacing: 0.18em;
    line-height: 1; color: #f2fbff;
    background: linear-gradient(100deg, #dff8ff 10%, #61edff 45%, #a68aff 75%, #7dffce 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    text-shadow: 0 0 42px rgba(97, 237, 255, 0.55), 0 2px 18px rgba(3, 4, 11, 0.9);
  }
  .boot-sub {
    position: relative; margin-top: 18px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px; letter-spacing: 0.42em; color: rgba(214, 240, 255, 0.85);
    text-shadow: 0 1px 12px rgba(3, 4, 11, 0.9), 0 0 24px rgba(97, 237, 255, 0.35);
  }
  .boot-controls {
    position: absolute; left: 0; right: 0; bottom: 28px;
    display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; padding: 0 16px;
    /* 控制按钮可点（遮罩其余部分不拦截） */
    pointer-events: auto;
  }
  .boot-controls button {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px; letter-spacing: 0.18em;
    color: rgba(214, 240, 255, 0.85);
    background: rgba(3, 4, 11, 0.55);
    border: 1px solid rgba(97, 237, 255, 0.28); border-radius: 999px;
    padding: 8px 16px; cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .boot-controls button:hover { background: rgba(97, 237, 255, 0.16); border-color: rgba(97, 237, 255, 0.6); }
  #boot-skip { border-color: rgba(166, 138, 255, 0.55); color: #e6dcff; }
  @media (max-width: 760px) {
    /* 手机端：按钮不遮挡主体（品牌在画面中央，按钮贴底且半透明）。 */
    .boot-controls { bottom: 20px; gap: 8px; }
    .boot-controls button { padding: 7px 12px; font-size: 10px; }
    .boot-sub { letter-spacing: 0.32em; }
  }
</style>
