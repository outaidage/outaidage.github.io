# Public browser config. Safe only with the RLS policies in supabase/schema.sql.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Site URL for canonical links / GitHub Pages
SITE_URL=https://outaidage.xyz
# For username.github.io repository use "/"; for a project repository use "/REPO_NAME"
BASE_PATH=/

# Used only by the Supabase Edge Function, never put these in PUBLIC_* variables.
# Set these as Supabase Function secrets, not in this file:
# GITHUB_TOKEN=...
# GITHUB_OWNER=...
# GITHUB_REPO=...
# GITHUB_BRANCH=main
